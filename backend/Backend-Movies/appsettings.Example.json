{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CorsSettings": {
    "FrontendUrl": "http://localhost:5173"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=moviesdb;Username=postgres;Password=your_password"
  },
  "Jwt": {
    "Key": "your_super_secret_jwt_key_at_least_32_characters_long",
    "Issuer": "Movies.Api",
    "Audience": "Movies.Api",
    "RefreshTokenDays": 7
  },
  "TMDb": {
    "ApiKey": "your_tmdb_api_key_here",
    "BaseUrl": "https://api.themoviedb.org/3/"
  }
}
