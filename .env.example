# ==============================================================================
# Streamify Root Environment Configuration Template
# Copy this file to '.env' to override default configuration
# ==============================================================================

# Database (PostgreSQL)
POSTGRES_USER=streamify_user
POSTGRES_PASSWORD=streamify_password_123!
POSTGRES_DB=streamify_db

# Security & JWT
JWT_SECRET=SuperSecretKeyForStreamifyJwtTokenProductionEvaluation2026!
JWT_ISSUER=streamify.api
JWT_AUDIENCE=streamify.client

# CORS & Networking
CORS_FRONTEND_URL=http://localhost,http://localhost:80

# The Movie Database (TMDb) API
# Get your free API key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=
